{
  "manifest_version": 3,
  "name": "TabsExplode",
  "version": "1.4.0",
  "description": "Bookmark every open tab in one click, keeping tab groups as folders.",
  "homepage_url": "https://github.com/badjuice/TabsExplode",
  "permissions": ["tabs", "tabGroups", "bookmarks", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bookmark all tabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
